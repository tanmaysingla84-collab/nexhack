<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CampusPool — Master Plan Map Verification & Graph Editor</title>
  <link rel="stylesheet" href="/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #090d16;
      color: #f1f5f9;
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
    }
    header {
      background: #012e55;
      border-bottom: 2px solid #e16b1f;
      padding: 0.6rem 1.2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      z-index: 1000;
    }
    .brand { display: flex; align-items: center; gap: 0.75rem; }
    .badge {
      background: #e16b1f;
      color: #fff;
      font-weight: 800;
      padding: 0.25rem 0.5rem;
      border-radius: 6px;
      font-size: 0.8rem;
    }
    .header-actions { display: flex; align-items: center; gap: 0.75rem; }
    button {
      background: #1e293b;
      color: #f8fafc;
      border: 1px solid #334155;
      padding: 0.4rem 0.75rem;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.35rem;
      transition: all 0.15s;
    }
    button:hover { background: #334155; border-color: #e16b1f; }
    button.primary { background: #e16b1f; border-color: #ea580c; color: white; }
    button.primary:hover { background: #ea580c; }
    button.active { background: #38bdf8; border-color: #0284c7; color: #0f172a; }

    #container {
      display: flex;
      flex: 1;
      height: calc(100vh - 54px);
    }
    #map {
      flex: 1;
      background: #030712;
      height: 100%;
    }
    #sidebar {
      width: 340px;
      background: #0f172a;
      border-left: 1px solid #1e293b;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .sidebar-header {
      padding: 0.75rem 1rem;
      background: #1e293b;
      font-weight: 700;
      font-size: 0.85rem;
      border-bottom: 1px solid #334155;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .sidebar-body {
      flex: 1;
      overflow-y: auto;
      padding: 0.75rem 1rem;
      font-size: 0.75rem;
    }
    .stat-pill {
      display: inline-block;
      padding: 0.2rem 0.5rem;
      border-radius: 9999px;
      background: #334155;
      color: #38bdf8;
      font-weight: 700;
      margin-right: 0.25rem;
    }
    .info-card {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 8px;
      padding: 0.65rem;
      margin-bottom: 0.75rem;
    }
    .info-card h4 {
      color: #e16b1f;
      margin-bottom: 0.35rem;
      font-size: 0.8rem;
    }
    .control-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.5rem;
    }
    input[type="range"] {
      width: 140px;
      accent-color: #e16b1f;
    }
    .node-label {
      background: rgba(15, 23, 42, 0.85);
      border: 1px solid #38bdf8;
      color: #fff;
      font-size: 10px;
      font-weight: 700;
      padding: 1px 4px;
      border-radius: 4px;
      white-space: nowrap;
    }
    .edge-label {
      background: rgba(15, 23, 42, 0.75);
      border: 1px solid #f97316;
      color: #fdba74;
      font-size: 9px;
      padding: 0 3px;
      border-radius: 3px;
    }
  </style>
</head>
<body>

  <header>
    <div class="brand">
      <span class="badge">GU</span>
      <div>
        <h2 style="font-size: 0.95rem; font-weight: 800; color: #fff;">Geeta University Master Plan — Map Verification & Graph Editor</h2>
        <span style="font-size: 0.7rem; color: #94a3b8;">Phase 1 Image Ground-Truth Alignment • 768 × 1024 px • L.CRS.Simple</span>
      </div>
    </div>
    <div class="header-actions">
      <button id="btn-toggle-editor" onclick="toggleEditor()">✏️ Enable Drag / Edit</button>
      <button id="btn-export-json" class="primary" onclick="exportJSON()">💾 Export campus.json</button>
      <a href="/" style="text-decoration:none;"><button>🚀 Back to App</button></a>
    </div>
  </header>

  <div id="container">
    <div id="map"></div>

    <aside id="sidebar">
      <div class="sidebar-header">
        <span>Graph Inspection & Stats</span>
        <span id="edit-indicator" style="font-size: 0.7rem; color: #10b981;">VIEW MODE</span>
      </div>
      <div class="sidebar-body">
        <div class="info-card">
          <h4>🗺️ Calibration & Image Bounds</h4>
          <p><strong>Blueprint:</strong> 768 × 1024 px</p>
          <p><strong>Scale:</strong> 1.10 meters / pixel</p>
          <p><strong>Total Coverage:</strong> 845m × 1126m (~95 hectares)</p>
          <div class="control-row" style="margin-top: 0.5rem;">
            <span>Blueprint Opacity:</span>
            <input type="range" id="opacity-slider" min="0" max="1" step="0.05" value="0.92" oninput="updateOpacity(this.value)">
          </div>
        </div>

        <div class="info-card">
          <h4>📊 Graph Topology Status</h4>
          <div style="margin-bottom: 0.4rem;">
            <span class="stat-pill" id="stat-nodes">22 Nodes</span>
            <span class="stat-pill" id="stat-edges">28 Edges</span>
            <span class="stat-pill" id="stat-stops">16 Stops</span>
          </div>
          <p style="color: #10b981; font-weight: 600;">✓ 100% Strongly Connected</p>
          <p style="color: #94a3b8; font-size: 0.7rem; margin-top: 0.2rem;">All roads verified bidirectional with speed limits from 12 km/h to 25 km/h.</p>
        </div>

        <div class="info-card" id="selection-card">
          <h4>📍 Selected Element</h4>
          <p id="selection-detail" style="color: #94a3b8;">Click any node, road edge, or stop to inspect spatial metadata, waypoints, and travel time.</p>
        </div>

        <div class="info-card">
          <h4>⚠️ Items Awaiting Confirmation</h4>
          <ul style="padding-left: 1rem; color: #cbd5e1; font-size: 0.72rem; line-height: 1.4;">
            <li><strong>Service Road West:</strong> Mapped as drivable for electric shuttles avoiding walking quads.</li>
            <li><strong>Playground East Corridor:</strong> Mapped connecting Hostel Strip to East Hostels.</li>
            <li><strong>University Plaza Rotary:</strong> 2-lane circulatory loop around water channel.</li>
          </ul>
        </div>
      </div>
    </aside>
  </div>

  <script>
    let campusData = null;
    let map = null;
    let imageOverlay = null;
    let editMode = false;
    let nodeMarkers = new Map();
    let edgeLines = new Map();

    const IMG_W = 768;
    const IMG_H = 1024;

    // Load campus data from data/campus.json
    fetch('/data/campus.json')
      .then(res => res.json())
      .then(data => {
        campusData = data;
        initMap();
      })
      .catch(err => {
        console.error('Failed to load campus.json, fallback to embedded', err);
      });

    function initMap() {
      // Leaflet Simple CRS for flat image pixel coordinates
      // In L.CRS.Simple: Lat is Y from bottom-up, Lng is X
      // Blueprint has Y from top (0) to bottom (1024), so y_map = IMG_H - y_image
      const toMapLatLng = (x, y) => [IMG_H - y, x];
      const toImageXY = (lat, lng) => [Math.round(lng), Math.round(IMG_H - lat)];

      const bounds = [[0, 0], [IMG_H, IMG_W]];

      map = L.map('map', {
        crs: L.CRS.Simple,
        minZoom: -1,
        maxZoom: 2,
        zoomSnap: 0.25
      });

      // Add the master plan blueprint image overlay
      imageOverlay = L.imageOverlay('/images/campus-master-plan.jpg', bounds, {
        opacity: 0.92
      }).addTo(map);

      map.fitBounds(bounds);

      renderGraph();
    }

    function renderGraph() {
      if (!campusData) return;

      const toMapLatLng = (x, y) => [IMG_H - y, x];

      // Draw Edges
      campusData.edges.forEach(edge => {
        const fromN = campusData.nodes.find(n => n.id === edge.from);
        const toN = campusData.nodes.find(n => n.id === edge.to);
        if (!fromN || !toN) return;

        const p1 = toMapLatLng(fromN.x, fromN.y);
        const p2 = toMapLatLng(toN.x, toN.y);

        const poly = L.polyline([p1, p2], {
          color: edge.status === 'closed' ? '#ef4444' : '#f97316',
          weight: 4,
          opacity: 0.85
        }).addTo(map);

        poly.on('click', () => {
          selectEdge(edge);
        });

        edgeLines.set(edge.id, poly);
      });

      // Draw Nodes
      campusData.nodes.forEach(node => {
        const pos = toMapLatLng(node.x, node.y);
        const isStop = campusData.stops.some(s => s.nodeId === node.id);

        let color = '#38bdf8'; // default junction
        if (node.type === 'gate') color = '#10b981';
        else if (node.type === 'hostel') color = '#a855f7';
        else if (node.type === 'sports') color = '#eab308';
        else if (node.type === 'landmark' || node.type === 'admin') color = '#f97316';

        const marker = L.circleMarker(pos, {
          radius: isStop ? 8 : 5,
          fillColor: color,
          color: '#ffffff',
          weight: 2,
          fillOpacity: 0.95
        }).addTo(map);

        marker.bindTooltip(`<strong>${node.id}</strong>: ${node.name}`, {
          permanent: false,
          direction: 'top'
        });

        marker.on('click', () => {
          selectNode(node);
        });

        nodeMarkers.set(node.id, marker);
      });
    }

    function selectNode(node) {
      const isStop = campusData.stops.find(s => s.nodeId === node.id);
      document.getElementById('selection-detail').innerHTML = `
        <div style="color:#fff; font-weight:700; font-size:0.85rem; margin-bottom:0.25rem;">
          ${node.name} (${node.id})
        </div>
        <p><strong>Type:</strong> <span style="text-transform:uppercase; color:#38bdf8;">${node.type}</span></p>
        <p><strong>Image Pixels:</strong> X: ${node.x}, Y: ${node.y}</p>
        <p><strong>Designated Stop:</strong> ${isStop ? `<span style="color:#10b981;">Yes (${isStop.id})</span>` : 'No (Transit Junction)'}</p>
        <p><strong>Connected Roads:</strong> ${campusData.edges.filter(e => e.from === node.id || e.to === node.id).map(e => e.id).join(', ')}</p>
      `;
    }

    function selectEdge(edge) {
      const fromN = campusData.nodes.find(n => n.id === edge.from);
      const toN = campusData.nodes.find(n => n.id === edge.to);
      document.getElementById('selection-detail').innerHTML = `
        <div style="color:#fff; font-weight:700; font-size:0.85rem; margin-bottom:0.25rem;">
          Road Segment ${edge.id}
        </div>
        <p><strong>From:</strong> ${fromN?.name} (${edge.from})</p>
        <p><strong>To:</strong> ${toN?.name} (${edge.to})</p>
        <p><strong>Length:</strong> ${edge.lengthPx} px (${edge.lengthMeters} m)</p>
        <p><strong>Speed Limit:</strong> ${edge.speedKmh} km/h</p>
        <p><strong>Travel Time:</strong> ${edge.minutes} min</p>
        <p><strong>Status:</strong> <span style="color:${edge.status==='open'?'#10b981':'#ef4444'}; font-weight:700;">${edge.status.toUpperCase()}</span></p>
        <button style="margin-top:0.5rem; width:100%;" onclick="toggleRoadStatus('${edge.id}')">Toggle Open / Closed</button>
      `;
    }

    function toggleRoadStatus(edgeId) {
      const edge = campusData.edges.find(e => e.id === edgeId);
      if (!edge) return;
      edge.status = edge.status === 'open' ? 'closed' : 'open';
      const poly = edgeLines.get(edgeId);
      if (poly) {
        poly.setStyle({ color: edge.status === 'closed' ? '#ef4444' : '#f97316' });
      }
      selectEdge(edge);
    }

    function toggleEditor() {
      editMode = !editMode;
      const btn = document.getElementById('btn-toggle-editor');
      const ind = document.getElementById('edit-indicator');

      if (editMode) {
        btn.classList.add('active');
        btn.innerHTML = '🔒 Lock Positions';
        ind.innerHTML = 'EDIT MODE (Drag Nodes)';
        ind.style.color = '#f97316';
        alert('Editor Enabled: You can now click any node and drag it to fine-tune its position directly over the blueprint!');
      } else {
        btn.classList.remove('active');
        btn.innerHTML = '✏️ Enable Drag / Edit';
        ind.innerHTML = 'VIEW MODE';
        ind.style.color = '#10b981';
      }
    }

    function updateOpacity(val) {
      if (imageOverlay) {
        imageOverlay.setOpacity(parseFloat(val));
      }
    }

    function exportJSON() {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(campusData, null, 2));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", "campus.json");
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
    }
  </script>
</body>
</html>
